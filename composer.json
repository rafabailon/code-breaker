{
	"name": "code-breaker/code-breaker",
	"description": "Code Breaker - A command-line implementation of the classic code-breaking game.",
	"type": "project",
	"authors": [
		{
			"name": "arkham",
			"email": "arkham@example.com"
		}
	],
	"require": {
		"php": "^8.2"
	},
	"require-dev": {
		"phpunit/phpunit": "^11.5"
	},
	"autoload": {
		"psr-4": {
			"CodeBreaker\\": "src/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"CodeBreaker\\Tests\\": "tests/"
		}
	},
	"scripts": {
		"test": "phpunit"
	},
	"config": {
		"optimize-autoloader": true,
		"sort-packages": true
	}
}
